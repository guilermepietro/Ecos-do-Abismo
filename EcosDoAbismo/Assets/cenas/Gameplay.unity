MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 771164046}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b73cced9def087345bd3b49e474b2c43, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnciaoPrimeiroContato
  painelConversa: {fileID: 2020207465}
  textoConversa: {fileID: 735170524}
  dialogos:
  - "Ei! Ei, rapaz! Aqui! Por favor, n\xE3o passe direto!"
  - "Ahh... Pelos c\xE9us, finalmente algu\xE9m que n\xE3o pretende arrancar minha
    cabe\xE7a."
  - "Voc\xEA... Voc\xEA sabe usar essa espada, n\xE3o sabe? Hah! Que pergunta idiota.
    Claro que sabe."
  - "Escute, meu jovem... H\xE1 umas criaturas rondando por aqui. Quase acabaram
    comigo."
  - "Estas pernas j\xE1 n\xE3o me ajudam muito, sabe? Se puder dar um jeito naqueles
    desgra\xE7ados, ficarei lhe devendo uma."
  - "V\xE1, rapaz! Eu espero aqui. E tome cuidado... Ainda preciso agradecer direito
    quando voltar!"
